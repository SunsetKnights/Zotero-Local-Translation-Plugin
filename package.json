{
  "name": "zotero-local-translation",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "description": "Local PDF selection translation for Zotero using user-selected GGUF models and Vulkan GPU acceleration",
  "homepage": "https://github.com/SunsetKnights/Zotero-Local-Translation-Plugin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SunsetKnights/Zotero-Local-Translation-Plugin.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:native": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-native.ps1",
    "build:addon": "node scripts/build-addon.mjs",
    "package": "node scripts/package-addon.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "build": "npm run typecheck && npm run build:native && npm run build:addon && npm run package && npm run verify:package"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  }
}
