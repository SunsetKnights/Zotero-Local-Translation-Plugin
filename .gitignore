# Only production sources and reproducible build inputs belong in Git.
/*
!/.gitignore
!/.github/
!/README.md
!/updates.json
!/package.json
!/package-lock.json
!/tsconfig.json
!/addon/
!/src/
!/shared/
!/types/
!/native/
!/scripts/
!/resources/

/.github/**
!/.github/workflows/
!/.github/workflows/release.yml

/addon/**
!/addon/**/
!/addon/bootstrap.js
!/addon/prefs.js
!/addon/chrome.manifest
!/addon/manifest.json
!/addon/content/**/*.xhtml
!/addon/content/**/*.css
!/addon/locale/**/*.ftl
!/addon/icons/*.png

/src/**
!/src/**/
!/src/**/*.ts
/shared/**
!/shared/**/
!/shared/**/*.ts
/types/**
!/types/**/
!/types/**/*.d.ts

/native/**
!/native/src/
!/native/src/**/
!/native/src/**/*.cpp
!/native/src/**/*.h
!/native/CMakeLists.txt
!/native/vendor.lock.json

/scripts/*
!/scripts/build-native.ps1
!/scripts/build-addon.mjs
!/scripts/package-addon.mjs
!/scripts/verify-package.mjs
!/scripts/zip.mjs

/resources/**
!/resources/licenses/
!/resources/licenses/*.txt
!/resources/licenses/NOTICE.md

# Also exclude generated files and tests placed inside source directories.
**/node_modules/
**/tests/
**/__tests__/
*.test.*
*.spec.*
*.gguf
*.safetensors
*.onnx
*.pt
*.pth
*.bin
*.exe
*.dll
*.obj
*.o
*.pdb
*.lib
*.xpi
*.zip
*.tar
*.gz
*.log
*.tmp
*.tsbuildinfo
.env
.env.*
**/.DS_Store
**/Thumbs.db
