{
  "manifest_version": 2,
  "name": "Local Translation",
  "version": "1.0.2",
  "description": "Offline PDF selection translation with named GGUF model configurations and Vulkan GPU acceleration. No external services.",
  "homepage_url": "https://github.com/SunsetKnights/Zotero-Local-Translation-Plugin",
  "author": "Sunsetknights",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "applications": {
    "zotero": {
      "id": "local-translation@zotero.plugin",
      "update_url": "https://raw.githubusercontent.com/SunsetKnights/Zotero-Local-Translation-Plugin/main/updates.json",
      "strict_min_version": "8.0",
      "strict_max_version": "11.*"
    }
  }
}
